{
  "name": "hekaton",
  "version": "0.3.0",
  "private": true,
  "description": "Hekaton \u2014 a window manager and live dashboard for many Claude Code sessions",
  "homepage": "https://github.com/Phil-Bartlett/hekaton",
  "author": {
    "name": "Phil Bartlett",
    "email": "Phil-Bartlett@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist/main.cjs",
  "desktopName": "hekaton.desktop",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "node scripts/build.mjs && electron .",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "style:record": "node scripts/build.mjs && node scripts/style-check.mjs record",
    "style:compare": "node scripts/style-check.mjs compare",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "node scripts/build.mjs && electron-builder --publish never --win nsis",
    "dist:mac": "node scripts/build.mjs && electron-builder --publish never --mac dmg --arm64 --x64",
    "icon": "electron scripts/icon.cjs",
    "dist:linux": "node scripts/build.mjs && electron-rebuild -f -w node-pty && electron-builder --publish never --linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.10",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "io.github.philbartlett.hekaton",
    "productName": "Hekaton",
    "copyright": "Copyright \u00a9 2026 Phil Bartlett",
    "afterPack": "./scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "Phil-Bartlett",
        "repo": "hekaton",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/statusline-relay.sh",
        "to": "scripts/statusline-relay.sh"
      },
      {
        "from": "scripts/end-session.ps1",
        "to": "scripts/end-session.ps1"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Hekaton-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Hekaton"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Hekaton-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "executableName": "hekaton",
      "artifactName": "Hekaton-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Hekaton",
          "Comment": "Window manager for Claude Code sessions"
        }
      }
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "deb": {
      "packageCategory": "devel"
    }
  }
}
